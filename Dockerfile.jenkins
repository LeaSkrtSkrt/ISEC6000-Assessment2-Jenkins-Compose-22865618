# Use the official Docker CLI image as a source for the Docker client binary.
FROM docker:27-cli AS docker-cli

# Jenkins LTS controller image.
FROM jenkins/jenkins:lts-jdk17

# Root is used only while building the image.
USER root

# Install Git and supporting utilities required by Jenkins pipeline jobs.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# Copy the official Docker CLI into the Jenkins image.
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker

# Run Jenkins using the built-in non-root account.
USER jenkins
